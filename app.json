{
  "expo": {
    "name": "סמוכים",
    "slug": "somuchim",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "somuchim",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "ios": {
      "bundleIdentifier": "il.somuchim.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "il.somuchim.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2F6F5E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      ["expo-localization", { "supportsRTL": true, "forcesRTL": true }],
      ["expo-splash-screen", { "backgroundColor": "#2F6F5E", "image": "./assets/images/splash-icon.png", "imageWidth": 96 }],
      ["expo-location", { "locationWhenInUsePermission": "סמוכים משתמשת במיקום פעם אחת בצ׳ק-אין ובצ׳ק-אאוט, כדי לאשר להורים שהגעת. אין מעקב רציף." }],
      ["expo-image-picker", {
        "photosPermission": "כדי להעלות תמונת פרופיל, סרטון היכרות ומסמכים לאימות.",
        "cameraPermission": "כדי לצלם תמונת פרופיל, סלפי לאימות זהות וסרטון היכרות.",
        "microphonePermission": "כדי להקליט את הקול בסרטון ההיכרות."
      }]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
